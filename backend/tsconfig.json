{
	"compilerOptions": {
		"target": "es2017",
		"module": "ESNext",
		"lib": ["es6"],
		"allowJs": true,
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"noImplicitAny": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "node"
	},
	"ts-node": {
		"experimentalSpecifierResolution": "node",
		"transpileOnly": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
